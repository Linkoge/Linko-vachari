# Server only. Copy to .env locally; never commit it.
# Real credentials belong in the ignored .env or .private/mymarket-account.json.
# Leave credential placeholders empty in this tracked template.
LINKO_CODEX_BINARY=codex
# Optional: use a model available to the server's signed-in Codex account.
LINKO_CODEX_MODEL=
# Optional seed for the login assistant. Normally leave these empty: the owner enters the MyMarket
# phone/email and password once in the panel's assistant window, and the server stores them in
# LINKO_DATA_DIR/mymarket-account.json (mode 0600, git-ignored).
MYMARKET_PHONE=
MYMARKET_PASSWORD=
PORT=4310
# Always bind loopback; Tailscale Serve terminates remote HTTPS.
# Set the exact origin only during manager activation, after panel:setup.
LINKO_PUBLIC_ORIGIN=
LINKO_PANEL_AUTH=false
# Optional durable private runtime directory; must stay outside tracked assets.
LINKO_DATA_DIR=
HOST=127.0.0.1
HEADLESS=false
# Publishing is disabled until the local operator enables it deliberately.
ALLOW_PUBLISH=false
