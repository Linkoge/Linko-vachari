# Server only. Copy to .env locally; never commit it.
# Real credentials belong in the ignored .env or .private/mymarket-account.json.
# Leave credential placeholders empty in this tracked template.
LINKO_CODEX_BINARY=codex
# AI choices are saved in Settings, never in the environment.
LINKO_CLAUDE_BINARY=claude
# Optional first-account seed. Normally add accounts through Settings.
# Account credentials live in LINKO_DATA_DIR/mymarket-accounts.json (0600, ignored).
MYMARKET_PHONE=
MYMARKET_PASSWORD=
PORT=4310
# Always bind loopback; Tailscale Serve terminates remote HTTPS.
# Set the exact origin only during manager activation, after panel:setup.
LINKO_PUBLIC_ORIGIN=
# Unset: password required with a tailnet origin; trusted local mode needs no password.
# Explicit false skips only the panel password, retaining the tailnet identity allowlist.
# LINKO_PANEL_AUTH=false
# Optional durable private runtime directory; must stay outside tracked assets.
LINKO_DATA_DIR=
HOST=127.0.0.1
HEADLESS=false
# Initial Publish toggle value when automation settings are absent. Saved Settings win.
ALLOW_PUBLISH=false
# Initial Auto-relist toggle value. Monitoring continues every three hours.
# Auto-relisting requires Publish too. Retire items through My listings > Delete.
LINKO_AUTO_RELIST=false
